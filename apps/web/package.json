{
  "name": "cabinet-crm-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend React (Vite + Tailwind v4 + shadcn) du Cabinet CRM — adossé au sidecar FastAPI.",
  "scripts": {
    "dev": "vite",
    "server": "python ../api/crm_server.py --port 8765 --token devtoken --reload",
    "dev:all": "concurrently -n api,web -c blue,green -k \"npm:server\" \"npm:dev\"",
    "build:web": "tsc -b && vite build",
    "build": "tauri build",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ./openapi.json -o ./src/api/schema.d.ts",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:backend": "python -m pytest ../api"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@tanstack/react-query": "^5.62.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.469.0",
    "openapi-fetch": "^0.13.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-international-phone": "^4.8.0",
    "react-odontogram": "0.5.6",
    "react-router-dom": "^7.1.1",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cabinet-crm-api": "workspace:*",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.5.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
